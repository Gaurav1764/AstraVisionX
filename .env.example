# AstraVisionX Configuration
# Copy this file to .env and fill in your values.

# General
DEBUG=True
USE_CUDA=False

# API
API_HOST=0.0.0.0
API_PORT=8000

# Models
YOLO_MODEL_PATH=yolov8s-oiv7.pt
VIT_MODEL_NAME=vit_base_patch16_224
DETECTOR_CONF_THRESHOLD=0.10

# Model mode: "general" or "medical"
# "medical" adds clinical caveats and will use domain-specific models when available
MODEL_MODE=general

# LLM / Chatbot (get your free key at https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Session
SESSION_TTL_MINUTES=30

