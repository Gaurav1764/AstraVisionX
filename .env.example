# AstraVisionX Configuration
# Copy this file to .env and fill in your values.
#   Windows:  copy .env.example .env
#   macOS/Linux: cp .env.example .env

# ── Required ──────────────────────────────────────────────────────────────────
# Get your free Gemini API key at https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# ── Server ────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=True

# ── Model Selection ───────────────────────────────────────────────────────────
# YOLO checkpoint — 601-class Open Images v7 models.
# Options: yolov8n-oiv7.pt | yolov8s-oiv7.pt | yolov8m-oiv7.pt | yolov8x-oiv7.pt
# Note: INFERENCE_PRESET (below) overrides this when set to fast/high_accuracy.
YOLO_MODEL_PATH=yolov8m-oiv7.pt

# Vision Transformer for classification / XAI
VIT_MODEL_NAME=vit_base_patch16_224

# Model mode: "general" or "medical"
# "medical" adds clinical caveats and will use domain-specific models when available.
MODEL_MODE=general

# ── Inference Preset ──────────────────────────────────────────────────────────
# Selects a pre-tuned bundle of model + resolution + TTA settings.
# Options: fast | balanced | high_accuracy
#   fast          → yolov8n, 640px, no TTA  (~1-2 s/image on CPU)
#   balanced      → yolov8m, 960px, no TTA  (~5-10 s/image on CPU)  ← default
#   high_accuracy → yolov8x, 1280px, TTA on (~30-60 s/image on CPU)
INFERENCE_PRESET=balanced

# ── Fine-grained Inference Tuning ─────────────────────────────────────────────
# These are used only when INFERENCE_PRESET is not set or is overridden manually.

# Minimum confidence for a detection to be reported (0.0 – 1.0)
DETECTOR_CONF_THRESHOLD=0.10

# Inference image size in pixels (longer edge). Larger = slower but detects small objects better.
# Recommended values: 640 | 960 | 1280
DETECTOR_IMGSZ=960

# NMS IoU threshold — higher values merge overlapping boxes more aggressively.
# Tune down (e.g. 0.4) for crowded scenes with many people.
DETECTOR_IOU_THRESHOLD=0.55

# Test-time augmentation — averages predictions over flipped/scaled copies.
# Improves accuracy but roughly doubles inference time.
DETECTOR_AUGMENT=False

# Auto-contrast (CLAHE) preprocessing — helps with very dark or low-contrast images.
# Leave False unless benchmarks show improvement on your dataset.
ENABLE_AUTO_CONTRAST=False

# ── Features ──────────────────────────────────────────────────────────────────
# Enables Male / Female apparent-presentation filter chips in the UI.
# SENSITIVE: When True, renders a visual-presentation estimate (not identity).
# A disclaimer is shown in the UI whenever this is active.
# No face recognition, no identity matching, no persistent storage.
ENABLE_DEMOGRAPHIC_ESTIMATES=False

# ── Session ───────────────────────────────────────────────────────────────────
# How long an idle session is kept in memory before being evicted (minutes).
SESSION_TTL_MINUTES=30

# ── GPU ───────────────────────────────────────────────────────────────────────
# Set True only if a compatible NVIDIA GPU and CUDA 11.8+ are installed.
# The platform falls back to CPU automatically if CUDA is unavailable.
USE_CUDA=False
